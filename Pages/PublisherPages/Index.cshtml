@page "{id:int?}"
@model Prozan_Mara_Lab2.Pages.PublisherPages.IndexModel

@{
    ViewData["Title"] = "Publishers";
}

<h1>Publishers Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Publisher Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.PublisherData.Publishers)
        {
            string selectedRow = "";
            if (item.ID == Model.PublisherID)
            {
                selectedRow = "table-success";
            }
            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.PublisherName)
                </td>
                <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">Select</a> |
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.PublisherData.Books != null)
{
    <h3>Books Edited by Selected Publisher</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Book Title & Author</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.PublisherData.Books)
            {
                <tr>
                    <td>
                        @item.Title - @item.Author?.FullName
                    </td>
                </tr>
            }
        </tbody>
    </table>
}